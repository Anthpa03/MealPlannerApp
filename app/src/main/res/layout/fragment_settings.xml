<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <View
        android:id="@+id/settingsRoundedRectangleView"
        android:layout_width="wrap_content"
        android:layout_height="80dp"

        android:layout_marginTop="30dp"
        android:background="@drawable/rounded_rectangle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/settingsTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Settings"
        android:textColor="#333333"
        android:textSize="32sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@+id/settingsRoundedRectangleView"
        app:layout_constraintEnd_toEndOf="@+id/settingsRoundedRectangleView"
        app:layout_constraintStart_toStartOf="@+id/settingsRoundedRectangleView"
        app:layout_constraintTop_toTopOf="@+id/settingsRoundedRectangleView" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/settingsRoundedRectangleView">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/userIconImageView"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_gravity="center"
                android:layout_marginTop="10dp"
                android:src="@drawable/account" />

            <TextView
                android:id="@+id/usernameTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="Username"
                android:textColor="#333333"
                android:textSize="24dp"
                android:textStyle="bold" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:orientation="vertical"
                android:padding="15dp">
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/settings_card"
                    android:padding="11dp">
                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:id="@+id/editProfileIcon"
                        android:src="@drawable/edit"
                        android:background="@drawable/orange_circle"
                        android:padding="12dp"
                        android:contentDescription="Edit profile" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="20dp"
                        android:layout_centerVertical="true"
                        android:text="Edit Profile"
                        android:textColor="#333333"
                        android:textStyle="bold"
                        android:layout_toEndOf="@id/editProfileIcon"/>

                    <ImageButton
                        android:id="@+id/editProfileImageButton"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:backgroundTint="#FFFFFF"
                        android:contentDescription="Edit Profile Button"
                        android:src="@drawable/arrow_right" />
                </RelativeLayout>
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/settings_card"
                    android:padding="11dp">
                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:id="@+id/aboutImageView"
                        android:src="@drawable/about"
                        android:background="@drawable/orange_circle"
                        android:padding="12dp"
                        android:contentDescription="About" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="20dp"
                        android:layout_centerVertical="true"
                        android:text="About"
                        android:textColor="#333333"
                        android:textStyle="bold"
                        android:layout_toEndOf="@id/aboutImageView"/>

                    <ImageButton
                        android:id="@+id/aboutImageButton"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:backgroundTint="#FFFFFF"
                        android:contentDescription="About Button"
                        android:src="@drawable/arrow_right" />
                </RelativeLayout>
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/settings_card"
                    android:padding="11dp">
                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:id="@+id/logoutIcon"
                        android:src="@drawable/logout"
                        android:background="@drawable/orange_circle"
                        android:padding="12dp"
                        android:contentDescription="Logout icon" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="20dp"
                        android:layout_centerVertical="true"
                        android:text="Logout"
                        android:textColor="#333333"
                        android:textStyle="bold"
                        android:layout_toEndOf="@id/logoutIcon"/>

                    <ImageButton
                        android:id="@+id/logoutImageButton"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:backgroundTint="#FFFFFF"
                        android:contentDescription="Logout Button"
                        android:src="@drawable/arrow_right" />
                </RelativeLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>