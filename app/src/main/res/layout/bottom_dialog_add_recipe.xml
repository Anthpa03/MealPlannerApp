<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/dialog_background">

    <com.harrywhewell.scrolldatepicker.DayScrollDatePicker
        android:id="@+id/meal_add_date_picker"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/addRecipeTextView" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_add_recipe"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="80dp"
        android:text="Add Recipe"
        android:textColor="@color/darkRed"
        app:backgroundTint="@color/white"
        app:cornerRadius="30dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/meal_add_date_picker"
        app:rippleColor="#33AAAAAA"
        app:strokeColor="@color/dullRed"
        app:strokeWidth="2dp" />

    <ImageView
        android:id="@+id/imageView_remove"
        android:layout_width="70dp"
        android:layout_height="wrap_content"
        android:scaleType="centerCrop"
        android:src="@drawable/remove"
        app:tint="@color/darkRed"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/addRecipeTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="50dp"
        android:padding="8dp"
        android:text="Add Recipe to Meal Planner"
        android:textAlignment="viewStart"
        android:textColor="@color/dullRed"
        android:textSize="25dp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imageView_remove" />

    <ImageButton
        android:id="@+id/cancelButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="96dp"
        android:background="@android:color/transparent"
        android:paddingBottom="10dp"
        android:src="@drawable/cross"
        android:scaleType="fitCenter"
        android:contentDescription="Exit View"
        app:layout_constraintStart_toEndOf="@+id/imageView_remove"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/darkRed" />

</androidx.constraintlayout.widget.ConstraintLayout>
