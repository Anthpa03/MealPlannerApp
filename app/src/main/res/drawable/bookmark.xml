<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Filled Black when pressed or selected -->
    <item android:drawable="@drawable/bookmark_filled" android:state_selected="true"/>
    <item android:drawable="@drawable/bookmark_filled" android:state_pressed="true"/>

    <!-- Default: Transparent with Black outline -->
    <item android:drawable="@drawable/bookmark_outline"/>
</selector>
