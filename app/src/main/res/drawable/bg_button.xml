<?xml version="1.0" encoding="UTF-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Default white with red borders-->
    <item android:state_pressed="false" android:state_selected="false" android:state_focused="false" android:drawable="@drawable/button_empty"/>
    <!-- Filled orange when pressed -->
    <item android:drawable="@drawable/button_filled" android:state_focused="true" android:state_pressed="true"/>
    <item android:drawable="@drawable/button_filled" android:state_focused="false" android:state_pressed="true"/>
</selector>